#!/bin/bash
# 配置初始化：飞牛应用中心要求本文件存在（缺失会 10111）。
# 用户进入「应用设置」页时会先跑这里，确保持久化配置文件存在且可读。
set -uo pipefail

APPDEST="${TRIM_APPDEST:-/var/apps/dsh-fnos}"
PKGVAR="${TRIM_PKGVAR:-${APPDEST}/var}"
ENV_FILE="${PKGVAR}/app.env"

mkdir -p "${PKGVAR}" 2>/dev/null || true
[ -e "${ENV_FILE}" ] || : > "${ENV_FILE}"

printf '[%s] [config_init] 配置文件 %s 就绪\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "${ENV_FILE}" >> "${PKGVAR}/info.log" 2>/dev/null
exit 0
