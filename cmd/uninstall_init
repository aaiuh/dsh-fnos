#!/bin/bash
# 卸载前初始化：飞牛应用中心要求本文件存在（同 install_init，缺失会 10111）。
# 先停服务再让平台回收目录，避免进程占着文件导致卸载残留。
set -uo pipefail

APPDEST="${TRIM_APPDEST:-/var/apps/dsh-fnos}"
PKGVAR="${TRIM_PKGVAR:-${APPDEST}/var}"

say() { printf '[%s] [uninstall_init] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${PKGVAR}/info.log" 2>/dev/null; }

say "停止服务，准备卸载"
bash "${APPDEST}/cmd/main" stop >/dev/null 2>&1 || true

say "卸载前准备完成"
exit 0
