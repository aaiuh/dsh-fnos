#!/bin/bash
# DeepSeek Harness (dsh-fnos) 生命周期管理
#   start  = 后台拉起 dsh web，等到端口就绪才算成功
#   stop   = 杀进程组并释放端口
#   status = PID 存活且端口在听 -> 0；否则 -> 3
#   restart = stop + start
#
# dsh 的 --host 只接受具体地址（拒绝 0.0.0.0），所以默认取本机主网卡 IP；
# 用户也可以在安装向导里指定。
set -uo pipefail

APPDEST="${TRIM_APPDEST:-/var/apps/dsh-fnos}"
PKGVAR="${TRIM_PKGVAR:-${APPDEST}/var}"
VOL="${TRIM_APPDEST_VOL:-/vol1}"
APP_HOME="${VOL}/@appshare/dsh-fnos"

NODE_BIN="/var/apps/nodejs_v24/target/bin"
NPM_PREFIX="${APP_HOME}/.npm-global"
DSH_BIN="${NPM_PREFIX}/bin/dsh"

LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/dsh.pid"

# 网关适配层：飞牛统一网关经 app.sock 进来，外网经反代进来，两者都由同一个
# shim 处理（剥前缀、令牌换 cookie、WebSocket 透传）。
SHIM_SCRIPT="${APPDEST}/shim/gateway_shim.py"
SHIM_SOCK="${APPDEST}/app.sock"
SHIM_PORT="${DSH_SHIM_PORT:-3081}"
SHIM_PID_FILE="${PKGVAR}/shim.pid"
SHIM_LOG="${PKGVAR}/shim.log"
TOKEN_FILE="${PKGVAR}/dsh.token"
GATEWAY_PREFIX_ENV="/app/dsh-fnos"
PUBLIC_PREFIX_ENV="/dsh"

# 向导值：平台若注入环境变量就用注入值；没注入时读安装/设置页持久化的 app.env 兜底
ENV_FILE="${PKGVAR}/app.env"
if [ -r "${ENV_FILE}" ]; then
    _saved_port=""; _saved_host=""; _saved_reg=""
    while IFS='=' read -r _k _v; do
        case "${_k}" in
            ui_port|wizard_port) _saved_port="${_v}" ;;
            wizard_host) _saved_host="${_v}" ;;
            wizard_npm_registry) _saved_reg="${_v}" ;;
        esac
    done < "${ENV_FILE}"
    [ -n "${ui_port:-}" ] || ui_port="${_saved_port}"
    [ -n "${wizard_host+x}" ] || wizard_host="${_saved_host}"
    [ -n "${wizard_npm_registry:-}" ] || wizard_npm_registry="${_saved_reg}"
fi

PORT="${ui_port:-${wizard_port:-3080}}"
START_WAIT="${DSH_START_WAIT:-90}"

mkdir -p "${PKGVAR}" "${APP_HOME}" 2>/dev/null

log_msg() { printf '%s - [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${1}" "${2}" >> "${LOG_FILE}"; }
log_info() { log_msg INFO "$*"; }
log_error() { log_msg ERROR "$*"; }

# 主网卡 IP：dsh 拒绝通配地址，必须给一个具体地址
detect_host() {
    local h=""
    if [ -n "${wizard_host:-}" ]; then
        h="${wizard_host}"
    else
        h=$(ip -4 route get 1.1.1.1 2>/dev/null \
            | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
        [ -n "${h}" ] || h=$(hostname -I 2>/dev/null | awk '{print $1}')
        [ -n "${h}" ] || h="127.0.0.1"
    fi
    printf '%s' "${h}"
}

pid_alive() {
    local pid="${1:-}"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    # 僵尸进程不算活着
    [ "$(awk '{print $3}' "/proc/${pid}/stat" 2>/dev/null)" = "Z" ] && return 1
    return 0
}

port_listening() {
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}$"
}

# 占用监听端口的进程号（可能为空）。用于收掉上次异常退出或平台重启后遗留的孤儿：
# 它们占着端口，会让 start 误判「已在运行」，结果跑的还是旧版本的进程。
port_pids() {
    ss -ltnp 2>/dev/null | awk -v p=":${PORT}" '$4 ~ p"$"' \
        | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
}

kill_wait() {
    local target="$1" i=0
    [ -n "${target}" ] || return 0
    # -PID 表示整个进程组（setsid 拉起的），失败再退回单进程
    kill -TERM "-${target}" 2>/dev/null || kill -TERM "${target}" 2>/dev/null || true
    while pid_alive "${target}" && [ "${i}" -lt 15 ]; do sleep 1; i=$((i + 1)); done
    if pid_alive "${target}"; then
        kill -KILL "-${target}" 2>/dev/null || kill -KILL "${target}" 2>/dev/null || true
    fi
    return 0
}

shim_pid_alive() {
    local pid=""
    [ -r "${SHIM_PID_FILE}" ] && pid=$(head -n 1 "${SHIM_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    pid_alive "${pid}"
}

shim_listening() {
    [ -S "${SHIM_SOCK}" ] && ss -lx 2>/dev/null | grep -qF "${SHIM_SOCK}"
}

start_shim() {
    if shim_pid_alive && shim_listening; then
        log_info "网关适配层已在运行"
        return 0
    fi
    if [ ! -r "${SHIM_SCRIPT}" ]; then
        log_error "找不到网关适配层脚本：${SHIM_SCRIPT}"
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        log_error "系统缺少 python3，无法启动网关适配层（桌面入口会 502，端口直连不受影响）"
        return 1
    fi

    local host
    host=$(detect_host)
    log_info "启动网关适配层 sock=${SHIM_SOCK} tcp=127.0.0.1:${SHIM_PORT}"

    DSH_HOST="${host}" \
    DSH_PORT="${PORT}" \
    DSH_TOKEN_FILE="${TOKEN_FILE}" \
    DSH_GATEWAY_SOCK="${SHIM_SOCK}" \
    DSH_GATEWAY_PREFIX="${GATEWAY_PREFIX_ENV}" \
    DSH_PUBLIC_TCP="127.0.0.1:${SHIM_PORT}" \
    DSH_PUBLIC_PREFIX="${PUBLIC_PREFIX_ENV}" \
    DSH_NO_BUFFER="1" \
    DSH_SHIM_LOG="${SHIM_LOG}" \
    setsid python3 "${SHIM_SCRIPT}" >>"${SHIM_LOG}" 2>&1 &
    echo "$!" > "${SHIM_PID_FILE}"

    local i=0
    while [ "${i}" -lt 20 ]; do
        if shim_listening || ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${SHIM_PORT}$"; then
            log_info "网关适配层就绪（${i}s）"
            return 0
        fi
        sleep 1; i=$((i + 1))
    done
    log_error "网关适配层未就绪，最近日志："
    tail -n 15 "${SHIM_LOG}" 2>/dev/null | while read -r l; do log_error "  ${l}"; done
    return 1
}

stop_shim() {
    local pid=""
    [ -r "${SHIM_PID_FILE}" ] && pid=$(head -n 1 "${SHIM_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    if pid_alive "${pid}"; then
        log_info "停止网关适配层（pid ${pid}）"
        kill_wait "${pid}"
    fi
    # 兜底：按脚本路径收残留（限定 python3 调用，避免匹配到别的东西）
    for p in $(pgrep -f "python3 .*gateway_shim.py" 2>/dev/null); do
        [ "${p}" = "${pid}" ] && continue
        kill_wait "${p}"
    done
    rm -f "${SHIM_PID_FILE}" "${SHIM_SOCK}"
    return 0
}

stop_app() {
    local pid=""
    [ -r "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

    if pid_alive "${pid}"; then
        log_info "停止 dsh（pid ${pid}）"
        kill_wait "${pid}"
    fi

    # 收尸一：按可执行文件路径匹配（dsh 的启动参数里没有 --profile，按参数猜会漏）
    for p in $(pgrep -f "${DSH_BIN} web" 2>/dev/null); do
        [ "${p}" = "${pid}" ] && continue
        log_info "收掉残留进程 pid ${p}"
        kill_wait "${p}"
    done

    # 收尸二：按端口兜底，防止路径匹配也被绕过
    for p in $(port_pids); do
        [ "${p}" = "${pid}" ] && continue
        log_info "收掉占用端口 ${PORT} 的进程 pid ${p}"
        kill_wait "${p}"
    done

    rm -f "${PID_FILE}"

    # 端口没释放就不要报成功，否则上层会以为可以立刻重启
    local i=0
    while port_listening && [ "${i}" -lt 10 ]; do sleep 1; i=$((i + 1)); done
    if port_listening; then
        log_error "端口 ${PORT} 仍被占用，未能完全停止"
        return 1
    fi
    log_info "已停止"
    stop_shim
    return 0
}

start_app() {
    if [ ! -x "${DSH_BIN}" ]; then
        log_error "找不到 dsh 可执行文件：${DSH_BIN}（安装未完成？）"
        return 1
    fi
    if port_listening; then
        local cur=""
        [ -r "${PID_FILE}" ] && cur=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if pid_alive "${cur}"; then
            log_info "端口 ${PORT} 已在监听且进程是本应用的（pid ${cur}），视为运行中"
            return 0
        fi
        # 端口被别的进程占着（上次没停干净的孤儿）。直接认为「在运行」会让
        # 版本切换后仍然跑旧进程，所以先清干净再说。
        log_info "端口 ${PORT} 被非本应用记录的进程占用，先清理"
        stop_app || return 1
    fi

    local host
    host=$(detect_host)
    log_info "启动 dsh web  host=${host}  port=${PORT}"

    export PATH="${NODE_BIN}:${NPM_PREFIX}/bin:${PATH}"
    export HOME="${APP_HOME}"
    export DSH_HOME="${APP_HOME}"
    export NPM_CONFIG_PREFIX="${NPM_PREFIX}"
    export NPM_CONFIG_CACHE="${APP_HOME}/.npm-cache"
    export LANG="${LANG:-C.UTF-8}"

    # setsid 让它成为一个独立进程组，stop 时能整组带走
    setsid "${DSH_BIN}" web \
        --host "${host}" \
        --port "${PORT}" \
        --no-open \
        --trusted-host "${host}:${PORT}" \
        --trusted-host "${host}" \
        >> "${PKGVAR}/dsh.log" 2>&1 &
    local pid=$!
    echo "${pid}" > "${PID_FILE}"
    log_info "已拉起 pid=${pid}，等待端口就绪（最多 ${START_WAIT}s）"

    local i=0
    while [ "${i}" -lt "${START_WAIT}" ]; do
        if port_listening; then
            log_info "启动成功，端口 ${PORT} 就绪（${i}s）"
            # dsh 每次启动生成一次性 token 换 cookie；把带 token 的链接落盘，
            # 否则首次打开只会看到 401「authentication required」
            local url
            url=$(grep -oE "http://[^ ]+\?token=[A-Za-z0-9_-]+" "${PKGVAR}/dsh.log" 2>/dev/null | tail -1)
            if [ -n "${url}" ]; then
                printf '%s\n' "${url}" > "${APP_HOME}/entry-url.txt" 2>/dev/null || true
                # 适配层只需 token 值：它在浏览器不带 cookie 时自己去换一次
                printf '%s\n' "${url##*token=}" > "${TOKEN_FILE}" 2>/dev/null || true
                log_info "首次访问链接（含启动 token，浏览器会记住登录态，之后可直接访问端口）：${url}"
            else
                log_error "未从日志找到启动 token，桌面入口的自动登录可能失效"
            fi
            start_shim || log_error "网关适配层启动失败：桌面内嵌入口不可用，端口直连仍正常"
            return 0
        fi
        if ! pid_alive "${pid}"; then
            log_error "dsh 进程已退出，最近的日志："
            tail -n 25 "${PKGVAR}/dsh.log" 2>/dev/null | while read -r l; do log_error "  ${l}"; done
            rm -f "${PID_FILE}"
            return 1
        fi
        sleep 1; i=$((i + 1))
    done

    log_error "等待 ${START_WAIT}s 端口仍未就绪，判为失败"
    tail -n 25 "${PKGVAR}/dsh.log" 2>/dev/null | while read -r l; do log_error "  ${l}"; done
    return 1
}

case "${1:-}" in
    start)   start_app ;;
    stop)    stop_app ;;
    restart) stop_app; sleep 1; start_app ;;
    status)
        pid=""
        [ -r "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        # 有适配层时两者都要活（主进程活着但适配层死了，桌面入口会 502）；
        # 旧包没有适配层脚本时退回只看 dsh，避免升级瞬间被判异常反复重启。
        if [ -r "${SHIM_SCRIPT}" ]; then
            if { pid_alive "${pid}" || port_listening; } && shim_pid_alive; then
                exit 0
            fi
            exit 3
        fi
        if pid_alive "${pid}" || port_listening; then exit 0; else exit 3; fi
        ;;
    *)
        echo "usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
