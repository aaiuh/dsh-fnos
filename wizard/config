[
    {
        "stepTitle": "服务配置",
        "items": [
            {
                "type": "select",
                "field": "dsh_version",
                "label": "dsh 版本",
                "initValue": "0.2.1-rc.2",
                "options": [
                    {
                        "label": "0.2.1-rc.2（latest · 2026-10-17）",
                        "value": "0.2.1-rc.2"
                    },
                    {
                        "label": "0.2.1-rc.4（next · 2026-10-26）",
                        "value": "0.2.1-rc.4"
                    },
                    {
                        "label": "0.2.1-rc.3（2026-10-23）",
                        "value": "0.2.1-rc.3"
                    },
                    {
                        "label": "0.2.1-rc.1（2026-10-17）",
                        "value": "0.2.1-rc.1"
                    },
                    {
                        "label": "0.2.1-alpha.5（2026-10-16）",
                        "value": "0.2.1-alpha.5"
                    }
                ],
                "helpText": "装哪个版本的 dsh 本体。latest 是上游标记的稳定发布，next 是更新的预发布；两者不一定相同，这里按实际发布列出。装完也能在应用设置里改，改完会自动换版本并重启。"
            },
            {
                "type": "text",
                "field": "ui_port",
                "label": "监听端口",
                "initValue": "3080",
                "helpText": "改完会自动重启服务生效。访问方式是 http://设备IP:该端口。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入监听端口"
                    },
                    {
                        "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "请输入 1-65535 之间的端口号"
                    }
                ]
            },
            {
                "type": "text",
                "field": "wizard_host",
                "label": "监听地址（留空自动）",
                "initValue": "",
                "helpText": "留空自动取本机主网卡 IPv4；dsh 不接受 0.0.0.0。",
                "rules": [
                    {
                        "pattern": "^(?:|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))$",
                        "message": "请留空，或填一个 IPv4 地址"
                    }
                ]
            },
            {
                "type": "text",
                "field": "wizard_npm_registry",
                "label": "npm 源",
                "initValue": "https://registry.npmmirror.com",
                "helpText": "换 dsh 版本时从这里拉包。国内用默认的 npmmirror 最快。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入 npm 源地址"
                    },
                    {
                        "pattern": "^https?://[^\\s]+$",
                        "message": "请输入以 http:// 或 https:// 开头的地址"
                    }
                ]
            }
        ]
    }
]
